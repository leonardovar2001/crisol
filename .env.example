# ── Instancia ────────────────────────────────────────────────────────────────
# Nombre de tu organización, se muestra en la interfaz.
INSTANCE_NAME=Crisol
# Idioma por defecto de la interfaz: es | en
DEFAULT_LOCALE=es
# URL pública de la instancia. IMPORTANTE: es la que se codifica en los QR
# que escanean los participantes, así que tiene que ser alcanzable desde
# sus teléfonos (no "localhost" si están en otros dispositivos).
PUBLIC_URL=http://localhost:3000

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_USER=crisol
POSTGRES_PASSWORD=cambiame_antes_de_usar_esto
POSTGRES_DB=crisol
DATABASE_URL=postgres://crisol:cambiame_antes_de_usar_esto@db:5432/crisol

# ── Seguridad ────────────────────────────────────────────────────────────────
# OBLIGATORIO. Generalo con:  openssl rand -hex 32
# El servidor se niega a arrancar si está vacío o si es el valor de ejemplo.
SESSION_SECRET=

# ── Medios ───────────────────────────────────────────────────────────────────
MEDIA_DIR=/data/media
# Límite por archivo subido (MB). Un video largo llena un volumen rápido.
MAX_UPLOAD_MB=200
# Límite acumulado por escenario (MB).
MAX_SCENARIO_MB=2048

# ── Primer usuario ───────────────────────────────────────────────────────────
# Se crea sólo si la base está vacía; en una instancia con usuarios se ignora.
# Mínimo 8 caracteres. Si lo dejás vacío, el servidor arranca igual y te avisa
# por consola que todavía no hay con qué entrar.
BOOTSTRAP_EMAIL=admin@example.org
BOOTSTRAP_PASSWORD=
